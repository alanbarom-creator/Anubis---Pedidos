# ============================================================
# SUMEFRA OS — Variables de entorno
# ============================================================
# Copia este archivo como .env y rellena los valores reales.
# NUNCA subas .env a git.
#
# ¿Dónde encontrar estos valores?
# 1. Ve a https://supabase.com y abre tu proyecto
# 2. En el sidebar izquierdo: Settings → API
# 3. VITE_SUPABASE_URL  → "Project URL"  (ej: https://abcxyz.supabase.co)
# 4. VITE_SUPABASE_ANON_KEY → "Project API keys" → "anon public"
#    (La clave larga que empieza con "eyJ...")
# ============================================================

VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
